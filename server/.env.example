# Environment Variables for Server

# === REQUIRED FOR BASIC FUNCTIONALITY ===

# Gemini AI API Key (REQUIRED for AI responses)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection (REQUIRED for database)
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/database_name

# JWT Secret for Authentication (REQUIRED for login/auth)
JWT_SECRET=your_very_secure_random_string_here

# === OPTIONAL BUT RECOMMENDED ===

# Email Configuration (for OTP and password reset)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Server Configuration
PORT=8000
NODE_ENV=development

# Python Executor (for system commands - not needed on Vercel)
START_PY_EXECUTOR=false
PY_HOST=localhost
PY_PORT=8080
PYTHON_BIN=python3

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# === NOTES ===
# 1. Never commit this file to git - keep it in .gitignore
# 2. For Vercel deployment, add these in the Vercel dashboard under Environment Variables
# 3. For local development, copy this file to .env and fill in your actual values
# 4. Get Gemini API key from: https://makersuite.google.com/app/apikey
# 5. MongoDB Atlas allows 0.0.0.0/0 for Vercel serverless functions
